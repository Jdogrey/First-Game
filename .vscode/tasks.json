{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build game (MinGW)",
            "type": "shell",
            "command": "C:\\Program Files\\mingw64\\bin\\g++.exe",
            "args": [
                "-std=c++20",
                "-g",
                "-Wall",
                "-Wextra",
                "-fdiagnostics-color=always",
                "main.cpp",
                "Objects/GameMap.cpp",
                "Objects/room.cpp",
                "loader.cpp",
                "gameLoop.cpp",
                "operations.cpp",
                "-o",
                "main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}